# Copy this file to .env on the server and replace every CHANGE_ME value.
# Do not commit the real .env file.

# Public web port for the frontend Nginx container.
FRONTEND_PORT=8080

# Optional local-only database port. It is bound to 127.0.0.1 by docker-compose.yml.
DB_PORT=13306

# MariaDB settings.
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_DATABASE=yuncang
MARIADB_USER=yuncang
MARIADB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# Backend authentication. Use a long random value in production.
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_OR_LONG_SECRET
JWT_EXPIRES_IN=8h

# Optional image names used by docker compose build/up.
BACKEND_IMAGE=yuncang-backend:latest
FRONTEND_IMAGE=yuncang-frontend:latest

# Optional Docker object names. Keep defaults in production unless there is a naming conflict.
DB_CONTAINER_NAME=yuncang-db
BACKEND_CONTAINER_NAME=yuncang-backend
FRONTEND_CONTAINER_NAME=yuncang-frontend
DB_VOLUME_NAME=yuncang_mysql_data
